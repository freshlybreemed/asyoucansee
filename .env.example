# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (card on file + late fees)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shopify Admin API. Dev Dashboard app: set CLIENT_ID/SECRET. Legacy custom app: set ADMIN_TOKEN instead.
SHOPIFY_STORE_DOMAIN=as-you-can-see.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_LOCATION_ID=gid://shopify/Location/REPLACE_ME

# Notifications
# Mailgun: sending domain (e.g. mg.asyoucansee.com) + private API key. EU domains: MAILGUN_API_BASE=https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net
NOTIFY_FROM_EMAIL=rentals@asyoucansee.com
# Public site base for email links/images. Defaults to the Vercel production URL.
SITE_URL=
ADMIN_NOTIFY_EMAILS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vercel cron auth
CRON_SECRET=
